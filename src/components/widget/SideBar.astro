---
import Profile from "./Profile.astro";
import Tag from "./Tags.astro";
import Categories from "./Categories.astro";
import { Icon } from "astro-icon/components";

const className = Astro.props.class;
const showMap = Astro.url.pathname === "/";
---
<div id="sidebar" class:list={[className, "w-full"]}>
    <div class="flex flex-col w-full gap-4 mb-4">
        <Profile></Profile>
    </div>
    <div class="flex flex-col w-full gap-4 sticky top-24">
        <div id="sidebar-travel-globe" class:list={["onload-animation", { "hidden": !showMap }]} style="animation-delay: 150ms">
            <a class="travel-globe-card card-base" href="/photography" aria-label="Explore photography from around the world">
                <div class="travel-globe-visual" aria-hidden="true">
                    <span class="travel-orbit"></span>
                    <Icon name="material-symbols:public" class="travel-globe-icon"></Icon>
                    <span class="travel-pin travel-pin-one"></span>
                    <span class="travel-pin travel-pin-two"></span>
                    <span class="travel-pin travel-pin-three"></span>
                </div>
                <div class="travel-globe-copy">
                    <span class="travel-globe-kicker">Through the lens</span>
                    <strong>Stories across the map</strong>
                    <span class="travel-globe-meta">California · Iceland · Asia</span>
                </div>
                <Icon name="material-symbols:arrow-outward-rounded" class="travel-globe-arrow"></Icon>
            </a>
        </div>
        <Categories class="onload-animation" style={`animation-delay: ${showMap ? 200 : 150}ms`}></Categories>
        <Tag class="onload-animation" style={`animation-delay: ${showMap ? 250 : 200}ms`}></Tag>
    </div>
</div>

<style>
    .travel-globe-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-height: 8.5rem;
        padding: 1rem;
        transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
    }

    .travel-globe-card:hover {
        transform: translateY(-2px);
        border-color: color-mix(in srgb, var(--primary) 35%, transparent);
        box-shadow: var(--glass-highlight), var(--glass-shadow-hover);
    }

    .travel-globe-visual {
        position: relative;
        display: grid;
        flex: 0 0 auto;
        width: 5.6rem;
        height: 5.6rem;
        place-items: center;
        border-radius: 999px;
        color: var(--primary);
        background: color-mix(in srgb, var(--primary) 10%, white);
    }

    .travel-globe-icon {
        width: 4.8rem;
        height: 4.8rem;
        opacity: 0.82;
    }

    .travel-orbit {
        position: absolute;
        inset: 0.25rem -0.35rem;
        border: 1px solid color-mix(in srgb, var(--primary) 32%, transparent);
        border-radius: 50%;
        transform: rotate(-18deg);
    }

    .travel-pin {
        position: absolute;
        width: 0.48rem;
        height: 0.48rem;
        border: 2px solid white;
        border-radius: 50%;
        background: var(--primary);
        box-shadow: 0 2px 8px color-mix(in srgb, var(--primary) 55%, transparent);
    }

    .travel-pin-one {
        top: 1.45rem;
        left: 1.35rem;
    }

    .travel-pin-two {
        right: 1.15rem;
        top: 2.35rem;
    }

    .travel-pin-three {
        bottom: 1.15rem;
        left: 2.45rem;
    }

    .travel-globe-copy {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 0.2rem;
        color: rgba(26, 22, 18, 0.86);
    }

    .travel-globe-copy strong {
        font-size: 0.95rem;
        line-height: 1.3;
    }

    .travel-globe-kicker {
        color: var(--primary);
        font-size: 0.64rem;
        font-weight: 800;
        letter-spacing: 0.16em;
        text-transform: uppercase;
    }

    .travel-globe-meta {
        color: rgba(26, 22, 18, 0.48);
        font-size: 0.7rem;
        line-height: 1.4;
    }

    .travel-globe-arrow {
        position: absolute;
        right: 0.75rem;
        top: 0.75rem;
        width: 1rem;
        height: 1rem;
        color: rgba(26, 22, 18, 0.28);
        transition: color 180ms ease, transform 180ms ease;
    }

    .travel-globe-card:hover .travel-globe-arrow {
        color: var(--primary);
        transform: translate(1px, -1px);
    }

    :root.dark .travel-globe-visual {
        background: color-mix(in srgb, var(--primary) 16%, rgba(20, 18, 16, 0.65));
    }

    :root.dark .travel-pin {
        border-color: #241f1b;
    }

    :root.dark .travel-globe-copy {
        color: rgba(246, 241, 236, 0.9);
    }

    :root.dark .travel-globe-meta {
        color: rgba(246, 241, 236, 0.48);
    }

    :root.dark .travel-globe-arrow {
        color: rgba(246, 241, 236, 0.32);
    }
</style>
